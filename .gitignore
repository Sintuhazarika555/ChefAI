# 1. Virtual Environments (Excludes .venv and .venv312)
.venv/
.venv*/
.venv312/
venv/
ENV/
env/

# 2. Python Cache & Compiled Bytecode (Excludes all __pycache__ folders)
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyd

